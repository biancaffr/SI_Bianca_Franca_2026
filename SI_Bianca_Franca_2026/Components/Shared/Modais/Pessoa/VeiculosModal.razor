@using SI_Bianca_Franca_2026.DTOs.Pessoa
@using SI_Bianca_Franca_2026.Models.Pessoa
@using SI_Bianca_Franca_2026.Models.Localizacao
@using SI_Bianca_Franca_2026.Components.Shared
@using SI_Bianca_Franca_2026.Components.Shared.Modais.Localizacao

<Modal Visivel="_aberto"
       Titulo="@(_dto.Id == 0 ? "Novo Veículo" : "Editar Veículo")"
       Largura="800px"
       AoFechar="Fechar">

    @if (!string.IsNullOrEmpty(_erro))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @_erro
        </div>
    }

    @if (_carregando)
    {
        <p>Carregando...</p>
    }
    else
    {
        <EditForm Model="_dto" OnValidSubmit="Salvar">
            <DataAnnotationsValidator />

            <div style="display: flex; flex-wrap: wrap; gap: 12px;">

                @if (_dto.Id != 0)
                {
                    <div class="form-group" style="width: 80px;">
                        <label>Código</label>
                        <InputNumber class="form-control" @bind-Value="_dto.Id" disabled />
                    </div>
                }

                <div class="form-group" style="width: 110px;">
                    <label class="obrigatorio">Placa</label>
                    <InputText class="form-control" @bind-Value="_dto.Placa" maxlength="7"/>
                    <ValidationMessage For="@(() => _dto.Placa)" class="text-danger" />
                </div>

                <div class="form-group" style="flex: 1; min-width: 220px;">
                    <label>Tipo de Veículo</label>
                    <InputText class="form-control" @bind-Value="_dto.TipoVeiculo" maxlength="50" />
                    <ValidationMessage For="@(() => _dto.TipoVeiculo)" class="text-danger" />
                </div>

                <div class="form-group" style="flex: 1; min-width: 220px;">
                    <label>Marca</label>
                    <InputText class="form-control" @bind-Value="_dto.MarcaModelo" maxlength="50" />
                    <ValidationMessage For="@(() => _dto.MarcaModelo)" class="text-danger" />
                </div>

                <div class="form-group" style="width: 100%;">
                    <hr class="my-1" />
                </div>

                <div class="form-group" style="width: 150px;">
                    <label>RNTRC</label>
                    <InputText class="form-control" @bind-Value="_dto.Rntrc" maxlength="8" />
                    <ValidationMessage For="@(() => _dto.Rntrc)" class="text-danger" />
                </div>

                <div class="form-group" style="width: 180px;">
                    <label>Renavam</label>
                    <InputText class="form-control" @bind-Value="_dto.Renavam" maxlength="11" />
                    <ValidationMessage For="@(() => _dto.Renavam)" class="text-danger" />
                </div>

                <div class="form-group" style="flex: 1; min-width: 220px;">
                    <label class="obrigatorio">Estado</label>
                    <div class="input-group">
                        <InputSelect class="form-select" @bind-Value="_dto.IdEstado">
                            <option value="0">Selecione...</option>
                            @foreach (var e in _estados)
                            {
                                <option value="@e.Id.ToString()">@e.Estado (@e.Uf)</option>
                            }
                        </InputSelect>
                        <button type="button" class="btn btn-outline-secondary"
                                title="Novo estado" @onclick="AbrirModalNovoEstado">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _dto.IdEstado)" class="text-danger" />
                </div>

                <div class="form-group" style="flex: 1; min-width: 220px;">
                    <label>Transportadora</label>
                    <InputSelect class="form-select" @bind-Value="_dto.IdTransportadora">
                        <option value="">Nenhuma</option>
                        @foreach (var t in _transportadoras)
                        {
                            <option value="@t.Id.ToString()">@t.NomeRazaoSocial</option>
                        }
                    </InputSelect>
                </div>

                @if (_dto.Id != 0)
                {
                    <div class="form-group" style="width: 100px;">
                        <label>Status</label>
                        <div class="form-check form-switch mt-1">
                            <InputCheckbox class="form-check-input" @bind-Value="_dto.Ativo" />
                            <label class="form-check-label">@(_dto.Ativo ? "Ativo" : "Inativo")</label>
                        </div>
                    </div>
                }
            </div>

            <div class="card mb-3 mt-2">
                <div class="card-header">Observações</div>
                <div class="card-body">
                    <InputTextArea class="form-control" @bind-Value="_dto.Observacao" rows="2" />
                </div>
            </div>

            @if (_dto.Id != 0)
            {
                <hr />
                <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;">
                    <div class="form-group">
                        <label>Data de Criação</label>
                        <input class="form-control" disabled
                               value="@_dto.DataCriacao.ToString("dd/MM/yyyy HH:mm:ss")" />
                    </div>
                    <div class="form-group">
                        <label>Última Alteração</label>
                        <input class="form-control" disabled
                               value="@_dto.DataUltimaAlteracao.ToString("dd/MM/yyyy HH:mm:ss")" />
                    </div>
                    <div class="form-group">
                        <label>Alterado por</label>
                        <input class="form-control" disabled value="@_dto.NomeUsuarioAlteracao" />
                    </div>
                </div>
            }

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" @onclick="Fechar">Cancelar</button>
                <button type="submit" class="btn btn-primary">Salvar</button>
            </div>
        </EditForm>
    }
</Modal>

<EstadosModal @ref="_modalEstado" AoSalvarComSucesso="OnEstadoSalvoAsync" />