@using SI_Bianca_Franca_2026.Components.Shared
@using SI_Bianca_Franca_2026.Components.Shared.Modais.Produto

<Modal Visivel="_aberto"
       Titulo="@(_dto.Id == 0 ? "Novo Produto" : "Editar Produto")"
       Largura="1100px"
       AoFechar="Fechar">

    @if (!string.IsNullOrEmpty(_erro))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_erro
        </div>
    }

    @if (_carregando)
    {
        <p>Carregando...</p>
    }
    else
    {
        <EditForm Model="_dto" OnValidSubmit="Salvar">
            <DataAnnotationsValidator />

            <div style="display: flex; flex-wrap: wrap; gap: 12px;">

                @if (_dto.Id != 0)
                {
                    <div class="form-group" style="width: 80px;">
                        <label>Código</label>
                        <InputNumber class="form-control" @bind-Value="_dto.Id" disabled />
                    </div>
                }

                @if (_dto.Id == 0)
                {
                    <div class="form-group" style="width: 165px;">
                        <label class="obrigatorio">Tipo</label>
                        <InputSelect class="form-select" @bind-Value="_dto.Tipo">
                            <option value="">Selecione...</option>
                            <option value="PRODUTO_FINAL">Produto Final</option>
                            <option value="MATERIA_PRIMA">Matéria-Prima</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => _dto.Tipo)" class="text-danger" />
                    </div>
                }
                else
                {
                    <div class="form-group" style="width: 165px;">
                        <label>Tipo</label>
                        <input class="form-control" disabled
                               value="@(_dto.Tipo == "PRODUTO_FINAL" ? "Produto Final" : "Matéria-Prima")" />
                    </div>
                }

                <div class="form-group" style="flex: 1; min-width: 300px;">
                    <label class="obrigatorio">Produto</label>
                    <InputText class="form-control" @bind-Value="_dto.Produto" maxlength="70"/>
                    <ValidationMessage For="@(() => _dto.Produto)" class="text-danger" />
                </div>

                <div class="form-group" style="width: 260px;">
                    <label class="obrigatorio">Unidade de Medida</label>
                    <div class="input-group">
                        <InputSelect class="form-select" @bind-Value="_dto.IdUnidadeMedida">
                            <option value="0">Selecione...</option>
                            @foreach (var u in _unidades)
                            {
                                <option value="@u.Id.ToString()">@u.Sigla — @u.UnidadeMedida</option>
                            }
                        </InputSelect>
                        <button type="button" class="btn btn-outline-secondary"
                                title="Nova unidade" @onclick="AbrirModalNovaUnidade">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _dto.IdUnidadeMedida)" class="text-danger" />
                </div>

                <div class="form-group" style="width: 230px;">
                    <label class="obrigatorio">Categoria</label>
                    <div class="input-group">
                        <InputSelect class="form-select" @bind-Value="_dto.IdCategoria">
                            <option value="0">Selecione...</option>
                            @foreach (var c in _categorias)
                            {
                                <option value="@c.Id.ToString()">@c.Categoria</option>
                            }
                        </InputSelect>
                        <button type="button" class="btn btn-outline-secondary"
                                title="Nova categoria" @onclick="AbrirModalNovaCategoria">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _dto.IdCategoria)" class="text-danger" />
                </div>

                <div class="form-group" style="width: 160px;">
                    <label>Referência</label>
                    <InputText class="form-control" @bind-Value="_dto.Referencia" maxlength="20" />
                </div>
                @if (_dto.Id != 0)
                {
                    <div class="form-group" style="width: 100px;">
                        <label>Status</label>
                        <div class="form-check form-switch mt-1">
                            <InputCheckbox class="form-check-input" @bind-Value="_dto.Ativo" />
                            <label class="form-check-label">@(_dto.Ativo ? "Ativo" : "Inativo")</label>
                        </div>
                    </div>
                }
            </div>

            <hr />

            <div style="display: flex; flex-wrap: wrap; gap: 12px;" @key="_dto.Id">

                <div class="form-group" style="width: 140px;">
                    <label>Estoque Mín</label>
                    <input class="form-control" type="text" maxlength="11" value="@EstoqueMinimoTexto"
                           @onchange="e => EstoqueMinimoTexto = e.Value?.ToString() ?? string.Empty" />
                    <ValidationMessage For="@(() => _dto.EstoqueMinimo)" class="text-danger" />
                </div>


                @if (_dto.Tipo == "PRODUTO_FINAL")
                {
                    <div class="form-group" style="width: 180px;">
                        <label>Preço de Venda</label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input class="form-control" type="text" maxlength="8"
                                   value="@PrecoVendaTexto"
                                   @onchange="e => PrecoVendaTexto = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <ValidationMessage For="@(() => _dto.PrecoVenda)" class="text-danger" />
                    </div>
                }

                <div class="form-group" style="width: 180px;">
                    <label>Valor Última Compra</label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input class="form-control" type="text" maxlength="8" value="@ValorUltimaCompraTexto"
                               @onchange="e => ValorUltimaCompraTexto = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <ValidationMessage For="@(() => _dto.ValorUltimaCompra)" class="text-danger" />
                </div>

                <div class="form-group" style="width: 130px;">
                    <label>NCM</label>
                    <InputText class="form-control" @bind-Value="_dto.Ncm" maxlength="8"/>
                    <ValidationMessage For="@(() => _dto.Ncm)" class="text-danger" />
                </div>

                <div class="form-group" style="width: 115px;">
                    <label>CEST</label>
                    <InputText class="form-control" @bind-Value="_dto.Cest" maxlength="7"/>
                    <ValidationMessage For="@(() => _dto.Cest)" class="text-danger" />
                </div>

                <div class="form-group" style="width: 320px;">
                    <label>Origem</label>
                    <InputSelect class="form-control" @bind-Value="_dto.Origem">
                        @foreach (var o in OrigensDisponiveis)
                        {
                            <option value="@o.Key">@o.Value</option>
                        }
                    </InputSelect>
                </div>

            </div>

            <div class="card mb-3 mt-2">
                <div class="card-header">Observações</div>
                <div class="card-body">
                    <InputTextArea class="form-control" @bind-Value="_dto.Observacao" rows="2" />
                </div>
            </div>

            @if (_dto.Id != 0)
            {
                <hr />
                <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;">
                    <div class="form-group">
                        <label>Data de Criação</label>
                        <input class="form-control" disabled
                               value="@_dto.DataCriacao.ToString("dd/MM/yyyy HH:mm:ss")" />
                    </div>
                    <div class="form-group">
                        <label>Última Alteração</label>
                        <input class="form-control" disabled
                               value="@_dto.DataUltimaAlteracao.ToString("dd/MM/yyyy HH:mm:ss")" />
                    </div>
                    <div class="form-group">
                        <label>Alterado por</label>
                        <input class="form-control" disabled value="@_dto.NomeUsuarioAlteracao" />
                    </div>
                </div>
            }

            <div class="form-actions">
                @if (_dto.Id != 0)
                {
                    <button type="button" class="btn btn-outline-danger me-auto"
                            @onclick="PedirConfirmacaoExclusao">
                        <i class="bi bi-trash me-1"></i>Excluir
                    </button>
                }
                <button type="button" class="btn btn-secondary" @onclick="Fechar">Cancelar</button>
                <button type="submit" class="btn btn-primary">Salvar</button>
            </div>

        </EditForm>
    }
</Modal>

<CategoriasModal @ref="_modalCategoria" AoSalvarComSucesso="OnCategoriaSalva" />
<UnidadesMedidaModal @ref="_modalUnidade" AoSalvarComSucesso="OnUnidadeSalva" />
<ModalConfirmacao @ref="_modalConfirmacao" AoConfirmar="ConfirmarExclusao" />