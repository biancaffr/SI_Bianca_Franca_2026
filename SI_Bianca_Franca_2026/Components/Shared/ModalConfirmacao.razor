@using SI_Bianca_Franca_2026.Components.Shared

<Modal Visivel="_aberto"
       Titulo="Confirmar Exclusão"
       Largura="420px"
       AoFechar="Fechar">

    <div class="text-center py-2">
        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 2.5rem;"></i>
        <p class="mt-3 mb-1">@_mensagem</p>
        <p class="text-muted" style="font-size: 13px;">Esta ação não poderá ser desfeita.</p>
    </div>

    <div class="form-actions">
        <button type="button" class="btn btn-secondary" @onclick="Fechar">Cancelar</button>
        <button type="button" class="btn btn-danger" @onclick="Confirmar">
            <i class="bi bi-trash me-1"></i>Excluir
        </button>
    </div>
</Modal>