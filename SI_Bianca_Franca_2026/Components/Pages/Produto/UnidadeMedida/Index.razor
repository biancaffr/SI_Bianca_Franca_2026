@page "/unidades-medida"
@rendermode InteractiveServer
@using SI_Bianca_Franca_2026.Components.Shared.Modais.Produto

<div class="mb-3">
    <h3 class="mb-0">Unidades de Medida</h3>
</div>

<div class="d-flex gap-2 mb-3">
    <input class="form-control" style="max-width: 300px;" placeholder="Pesquisar..."
           @bind="_filtro.Busca" @bind:event="oninput" @bind:after="OnFiltroAlterado" />

    <select class="w-auto" @bind="_filtro.StatusFiltro" @bind:after="OnFiltroAlterado">
        <option value="ativo">Ativos</option>
        <option value="inativo">Inativos</option>
        <option value="todos">Todos</option>
    </select>

    <button class="btn btn-primary" @onclick="AbrirCadastro">
        <i class="bi bi-plus-lg me-1"></i>Nova Unidade
    </button>
</div>

@if (_unidades is null)
{
    <p>Carregando...</p>
}
else if (!_unidades.Any())
{
    <p>Nenhuma unidade de medida encontrada.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Sigla</th>
                <th>Unidade de Medida</th>
                <th>Categoria</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in _unidades)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>@u.Sigla</td>
                    <td>@u.UnidadeMedida</td>
                    <td>@u.Categoria</td>
                    <td>
                        <span class="badge @(u.Ativo ? "bg-success" : "bg-danger")">
                            @(u.Ativo ? "Ativo" : "Inativo")
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => AbrirEdicao(u)">
                            Editar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<UnidadesMedidaModal @ref="_modalUnidade" AoSalvarComSucesso="OnUnidadeSalva" />