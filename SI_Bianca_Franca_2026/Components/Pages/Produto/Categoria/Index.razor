@page "/categorias"
@rendermode InteractiveServer
@using SI_Bianca_Franca_2026.Components.Shared.Modais.Produto

<div class="mb-3">
    <h3 class="mb-0">Categorias</h3>
</div>

<div class="d-flex gap-2 mb-3">
    <input class="form-control" style="max-width: 300px;" placeholder="Pesquisar..."
           @bind="_filtro.Busca" @bind:event="oninput" @bind:after="OnFiltroAlterado" />

    <select class="w-auto" @bind="_filtro.StatusFiltro" @bind:after="OnFiltroAlterado">
        <option value="ativo">Ativos</option>
        <option value="inativo">Inativos</option>
        <option value="todos">Todos</option>
    </select>

    <button class="btn btn-primary" @onclick="AbrirCadastro">
        <i class="bi bi-plus-lg me-1"></i>Nova Categoria
    </button>
</div>

@if (_categorias is null)
{
    <p>Carregando...</p>
}
else if (!_categorias.Any())
{
    <p>Nenhuma categoria encontrada.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Categoria</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _categorias)
            {
                var idLocal = c.Id;
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Categoria</td>
                    <td>
                        <span class="badge @(c.Ativo ? "bg-success" : "bg-danger")">
                            @(c.Ativo ? "Ativo" : "Inativo")
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => AbrirEdicao(c)">
                            Editar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<CategoriasModal @ref="_modalCategoria" AoSalvarComSucesso="OnCategoriaSalva" AoExcluirComSucesso="CarregarDados" />