@page "/veiculos"
@rendermode InteractiveServer
@using SI_Bianca_Franca_2026.Components.Shared.Modais.Pessoa

<div class="mb-3">
    <h3 class="mb-0">Veículos</h3>
</div>

<div class="d-flex gap-2 mb-3">
    <input class="form-control" style="max-width: 300px;" placeholder="Pesquisar..."
           @bind="_filtro.Busca" @bind:event="oninput" @bind:after="OnFiltroAlterado" />

    <select class="w-auto" @bind="_filtro.StatusFiltro" @bind:after="OnFiltroAlterado">
        <option value="ativo">Ativos</option>
        <option value="inativo">Inativos</option>
        <option value="todos">Todos</option>
    </select>

    <button class="btn btn-primary" @onclick="AbrirCadastro">
        <i class="bi bi-plus-lg me-1"></i>Novo Veículo
    </button>
</div>

@if (_veiculos is null)
{
    <p>Carregando...</p>
}
else if (!_veiculos.Any())
{
    <p>Nenhum veículo encontrado.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Placa</th>
                <th>Tipo</th>
                <th>Marca / Modelo</th>
                <th>Estado</th>
                <th>Transportadora</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in _veiculos)
            {
                var vLocal = v;
                <tr>
                    <td>@v.Id</td>
                    <td>@v.Placa</td>
                    <td>@(v.TipoVeiculo ?? "—")</td>
                    <td>@(v.MarcaModelo ?? "—")</td>
                    <td>@(v.OEstado?.Uf ?? "—")</td>
                    <td>@(v.OTransportadora?.NomeRazaoSocial ?? "—")</td>
                    <td>
                        <span class="badge @(v.Ativo ? "bg-success" : "bg-danger")">
                            @(v.Ativo ? "Ativo" : "Inativo")
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => AbrirEdicao(vLocal)">
                            Editar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<VeiculosModal @ref="_modalVeiculo" AoSalvarComSucesso="OnVeiculoSalvo" />