@page "/clientes"
@rendermode InteractiveServer
@using SI_Bianca_Franca_2026.Components.Shared.Modais.Pessoa

<div class="mb-3">
    <h3 class="mb-0">Clientes</h3>
</div>

<div class="d-flex gap-2 mb-3">
    <input class="form-control" style="max-width: 300px;" placeholder="Pesquisar..."
           @bind="_filtro.Busca" @bind:event="oninput" @bind:after="OnFiltroAlterado" />

    <select class="w-auto" @bind="_filtro.StatusFiltro" @bind:after="OnFiltroAlterado">
        <option value="ativo">Ativos</option>
        <option value="inativo">Inativos</option>
        <option value="todos">Todos</option>
    </select>

    <button class="btn btn-primary" @onclick="AbrirCadastro">
        <i class="bi bi-plus-lg me-1"></i>Novo Cliente
    </button>
</div>

@if (_clientes is null)
{
    <p>Carregando...</p>
}
else if (!_clientes.Any())
{
    <p>Nenhum cliente encontrado.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tipo</th>
                <th>Nome / Razão Social</th>
                <th>Cidade</th>
                <th>CPF / CNPJ</th>
                <th>Telefone</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cli in _clientes)
            {
                var idLocal = cli.Id;
                <tr>
                    <td>@cli.Id</td>
                    <td>@(cli.TipoPessoa == "FISICA" ? "Pessoa Física" : "Pessoa Jurídica")</td>
                    <td>@cli.NomeRazaoSocial</td>
                    <td>@($"{cli.OCidade.Cidade} - {cli.OCidade.OEstado?.Uf}")</td>
                    <td>@(cli.CpfCnpj ?? "—")</td>
                    <td>@(cli.Telefone ?? "—")</td>
                    <td>
                        <span class="badge @(cli.Ativo ? "bg-success" : "bg-danger")">
                            @(cli.Ativo ? "Ativo" : "Inativo")
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => AbrirEdicao(idLocal)">
                            Editar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<ClientesModal @ref="_modalCliente" AoSalvarComSucesso="OnClienteSalvo" />